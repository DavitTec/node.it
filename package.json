{
  "name": "node_it",
  "version": "0.2.1",
  "description": "simple node.js web server",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "test": "node ./test/index",
    "test:all": "mocha --recursive --exit",
    "clean": "node scripts/clean.js",
    "generate-static": "node scripts/generate-static.js",
    "generate-static:staging": "PROJECT_STATUS=staging node scripts/generate-static.js",
    "build": "pnpm clean && pnpm generate-static",
    "build:staging": "pnpm clean && pnpm generate-static:staging",
    "build:gh-pages": "pnpm clean && GH_PAGES=true pnpm generate-static",
    "predeploy": "pnpm build:gh-pages",
    "deploy": "gh-pages -d dist",
    "start": "node server.js",
    "release": "standard-version",
    "prelease": "standard-version -p ",
    "web": "node ./src/bin/server.js",
    "web:staging": "PROJECT_STATUS=staging node ./src/bin/server.js",
    "web:production": "PROJECT_STATUS=production node ./src/bin/server.js",
    "port:allow": "bash scripts/port-access.sh allow",
    "port:deny": "bash scripts/port-access.sh deny",
    "port:status": "bash scripts/port-access.sh status",
    "app": "node ./src/app",
    "makeicons": "node ./scripts/generate-favicons.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavitTec/node.it.git"
  },
  "keywords": [
    "nodejs",
    "http"
  ],
  "author": "David Mullins",
  "license": "https://github.com/DavitTec/node.it/blob/main/LICENSE",
  "bugs": {
    "url": "https://github.com/DavitTec/node.it/issues"
  },
  "homepage": "https://github.com/DavitTec/node.it#readme",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "gh-pages": "^6.3.0",
    "http-errors": "^2.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "ico-endec": "^0.1.6",
    "mocha": "^11.1.0",
    "sharp": "^0.35.4",
    "standard-version": "^9.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "js-yaml": "^4.3.2",
      "qs": "^6.16.0",
      "serialize-javascript": "^7.1.1"
    }
  }
}
