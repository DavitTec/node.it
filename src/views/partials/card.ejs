<div class="card card--<%= variant %>">
  <div class="card__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M4 20l1.1-3.9L15.8 5.4a1.5 1.5 0 0 1 2.1 0l0.7.7a1.5 1.5 0 0 1 0 2.1L8 18.9 4 20Z"
        stroke="#fff"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path d="M14.3 6.9l2.8 2.8" stroke="#fff" stroke-width="1.6" />
    </svg>
  </div>
  <h3 class="card__title"><%= title %></h3>
  <p class="card__description"><%= description %></p>
  <button class="card__button" type="button"><%= buttonText %></button>
</div>
